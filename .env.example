# TuneQuest Environment Configuration
# NOTE: Do NOT store private API secrets or credentials in VITE_* environment variables!
# Real backend authentication uses HttpOnly Secure Cookies.

VITE_APP_NAME=TuneQuest
VITE_APP_TAGLINE="Listen. Play. Earn. Unlock."
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEMO_MODE=true
VITE_ENABLE_ANALYTICS=false
VITE_AUDIO_SYNTH_FALLBACK=true
